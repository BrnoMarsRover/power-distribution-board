	(text "Charging: charger + enters on the bus side of the shunt and leaves through the pack's charge port,"
		(exclude_from_sim no)
		(at 20 36 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "1fe92188-3378-5c20-9409-6251fb4e8598")
	)
	(text "Battery 10S 30-42 V. The pack fuse (58 V rated) and BMS live in the harness, not on this board."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3a8cb046-1542-5db2-b6f3-17eff788c8f1")
	)
	(text "INA228 at 0x40 (A0 = A1 = GND), ADCRANGE = 0 (+-163.84 mV = +-82 A): bus V, current, power, and on-chip charge / energy."
		(exclude_from_sim no)
		(at 20 48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "3df6bdd8-36dc-5e31-84c3-621fff452f70")
	)
	(text "Battery input, bus protection and battery monitor"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "64a3f18c-3e47-57b4-9959-bdbe63b0d72f")
	)
	(text "so the INA228 counts it (net of the rover's own load). Charger - is NOT board GND: CHG_N goes straight to the pack's C-."
		(exclude_from_sim no)
		(at 20 42 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "cb96326c-ecdd-5354-86d1-5dca72a7cd90")
	)
	(text "R_SHUNT: Bourns CSS2H-2512K, Kelvin land pattern (net-tie footprint). Route SNS_P / SNS_N as a pair from the fingers."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
