	(text "drops the drive group if the chopper stays on (battery not accepting charge for a long time)."
		(exclude_from_sim no)
		(at 20 48 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9b11e252-c3d0-5fff-80cd-3845debf68d7")
	)
	(text "Hardware only: TLV1805 compares OUT42D against an LM4040 2.5 V reference and drives Q_BR directly. Runs from OUT42D through a 12 V zener,"
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "b08b5aef-7586-5c41-a851-90b77a59cfda")
	)
	(text "R_BRAKE is off-board on a heatsink (e.g. 10 ohm 100 W: 4.7 A at 47 V). BRAKE_ACT tells the ESP32 (IO39); firmware logs it and"
		(exclude_from_sim no)
		(at 20 42 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "bcce6341-dbe7-51bc-9101-fadf0b0ad07b")
	)
