	(text "Bus pins survive +-58 V faults internally. No external TVS: a 24 V CAN TVS would conduct if a CAN wire touched 42 V."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "097ab770-9765-5972-8c35-75a4fe487955")
	)
	(text "Split termination enabled by closing both solder jumpers (only at a bus end)."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
