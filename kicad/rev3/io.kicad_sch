	(text "TCA9535 at 0x20 holds INP / INP_G for all six switches, so they keep their state across an ESP32 reset."
		(exclude_from_sim no)
		(at 20 24 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "46eb7a68-61fd-5694-bb6e-5666027ce7f8")
	)
	(text "It stays off after the switch closes until the ESP32 clocks MOTOR_ARM, which it does only after dropping INP and re-running pre-charge. Power-on also starts latched off. The battery E-STOP is separate (BMS soft-start)."
		(exclude_from_sim no)
		(at 20 42 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "70eb9d9d-e168-5171-a127-e7eeaa7c4f0d")
	)
	(text "ADC128D818 at 0x1D (A1 = A0 = LOW) and 0x1E (A1 = LOW, A0 = MID). Internal 2.56 V reference; 12 ms per channel."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "7955fec2-0710-51ed-8d59-2e58e6694180")
	)
	(text "Switch control (TCA9535), measurement (ADC128D818 x2), motor-switch latch"
		(exclude_from_sim no)
		(at 20 18 0)
		(effects
			(font
				(size 2.5 2.5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "980356c3-1b00-5f9c-813a-6e0ae1aeb86f")
	)
	(text "Rear-panel motor switch (closed = motors allowed): opening it clears the latch (Q low, /Q high) -> MOTOR_KILL holds the drive group off."
		(exclude_from_sim no)
		(at 20 36 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "9f346d5d-eb93-57bf-84d9-2922007dd197")
	)
